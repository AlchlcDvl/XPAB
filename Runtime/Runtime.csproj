<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>XPAB.Runtime</AssemblyName>

    <ModLoader Condition="'$(ModLoader)' == ''">None</ModLoader>

    <DefineConstants Condition="'$(ModLoader)' != 'None'">$(DefineConstants);USES_LOADER</DefineConstants>
    <DefineConstants Condition="'$(ModLoader)' == 'BepInEx'">$(DefineConstants);BEPINEX</DefineConstants>
    <DefineConstants Condition="'$(ModLoader)' == 'MelonLoader'">$(DefineConstants);MELON_LOADER</DefineConstants>
    <DefineConstants Condition="'$(ModLoader)' == 'Custom'">$(DefineConstants);CUSTOM_LOADER</DefineConstants>

    <CompileTarget Condition="'$(CompileTarget)' == ''">Mono</CompileTarget>

    <DefineConstants Condition="'$(CompileTarget)' == 'Mono'">$(DefineConstants);MONO</DefineConstants>
    <DefineConstants Condition="'$(CompileTarget)' == 'Il2Cpp'">$(DefineConstants);IL2CPP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Core/**/*.cs" />

    <Reference Include="../Libs/Game/*.dll" Private="false" />

    <Reference Condition="'$(CompileTarget)' == 'Mono'" Include="../Libs/UnityMono/*.dll" Private="false" />
    <Reference Condition="'$(CompileTarget)' == 'Il2Cpp'" Include="../Libs/UnityIl2Cpp/*.dll" Private="false" />

    <Reference Condition="'$(ModLoader)' == 'BepInEx'" Include="../Libs/BepInEx/*.dll" Private="false" />
    <Reference Condition="'$(ModLoader)' == 'MelonLoader'" Include="../Libs/MelonLoader/*.dll" Private="false" />
    <Reference Condition="'$(ModLoader)' == 'Custom'" Include="../Libs/CustomLoader/*.dll" Private="false" />

    <Reference Condition="'$(ModLoader)' == 'BepInEx' and '$(CompileTarget)' == 'Il2Cpp'" Include="../Libs/BepIl2Cpp/*.dll" Private="false" />
    <Reference Condition="'$(ModLoader)' == 'MelonLoader' and '$(CompileTarget)' == 'Il2Cpp'" Include="../Libs/MelonIl2Cpp/*.dll" Private="false" />
    <Reference Condition="'$(ModLoader)' == 'Custom' and '$(CompileTarget)' == 'Il2Cpp'" Include="../Libs/CustomIl2Cpp/*.dll" Private="false" />

    <Reference Condition="'$(ModLoader)' == 'BepInEx' and '$(CompileTarget)' == 'Mono'" Include="../Libs/BepMono/*.dll" Private="false" />
    <Reference Condition="'$(ModLoader)' == 'MelonLoader' and '$(CompileTarget)' == 'Mono'" Include="../Libs/MelonMono/*.dll" Private="false" />
    <Reference Condition="'$(ModLoader)' == 'Custom' and '$(CompileTarget)' == 'Mono'" Include="../Libs/CustomMono/*.dll" Private="false" />

    <PackageReference Include="NVorbis" Version="*-*" />
  </ItemGroup>

  <Target Name="ILRepack" AfterTargets="Build">
    <ItemGroup>
      <InputAssemblies Include="$(OutputPath)$(AssemblyName).dll" />
      <InputAssemblies Include="$(OutputPath)NVorbis.dll" />
    </ItemGroup>

    <ILRepack
      OutputType="Dll"
      Internalize="true"
      MainAssembly="$(OutputPath)$(AssemblyName).dll"
      OutputAssembly="$(OutputPath)$(AssemblyName).dll"
      InputAssemblies="@(InputAssemblies)"
      LibraryPath="$(OutputPath)" />
  </Target>
</Project>
