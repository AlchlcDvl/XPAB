<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(CompileTarget)' == ''">
    <CompileTarget>Mono</CompileTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CompileTarget)' == 'Mono'">
    <DefineConstants>$(DefineConstants);MONO</DefineConstants>
    <AssemblyName>XPAB.Runtime.Mono</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CompileTarget)' == 'Il2Cpp'">
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
    <AssemblyName>XPAB.Runtime.Il2Cpp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Condition="'$(CompileTarget)' == 'Mono'" Include="../UnityMono/*.dll" Private="false" />
    <Reference Condition="'$(CompileTarget)' == 'Il2Cpp'" Include="../UnityIl2Cpp/*.dll" Private="false" />
  </ItemGroup>
</Project>
